{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac-btrfs-synology",
  "version": "0.1.0",
  "identifier": "com.bluweo.mac-btrfs-synology",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mac-btrfs-synology",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Read-only Synology Btrfs recovery",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
